{
  "name": "@nebula-db/plugin-streaming",
  "version": "0.6.1",
  "description": "Streaming analytics plugin for NebulaDB \u2014 real-time metrics and aggregations",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "dependencies": {
    "@nebula-db/core": "*"
  },
  "keywords": [
    "nebula-db",
    "streaming",
    "analytics",
    "plugin"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://nom-nom-hub.github.io/NebulaDB",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nom-nom-hub/NebulaDB.git"
  },
  "bugs": {
    "url": "https://github.com/Nom-nom-hub/NebulaDB/issues"
  }
}
