{
  "name": "@nebula-db/plugin-backup",
  "version": "0.6.0",
  "description": "Backup and restore utilities for NebulaDB",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "dependencies": {
    "@nebula-db/core": "*"
  },
  "keywords": ["nebula-db", "backup", "restore", "plugin"],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}