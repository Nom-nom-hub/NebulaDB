{
  "name": "@nebula-db/core",
  "version": "0.6.0",
  "description": "TypeScript-first embedded NoSQL database core \u2014 reactive, schema-optional, runs everywhere",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nom-nom-hub/NebulaDB.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "database",
    "nosql",
    "embedded",
    "typescript",
    "nebula-db"
  ],
  "author": "Nom-nom-hub",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "uuid": "^9.0.1",
    "vitest": "^3.1.2"
  },
  "dependencies": {
    "@preact/signals-core": "^1.5.1"
  },
  "homepage": "https://nom-nom-hub.github.io/NebulaDB",
  "bugs": {
    "url": "https://github.com/Nom-nom-hub/NebulaDB/issues"
  }
}
